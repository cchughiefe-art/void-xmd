BOT_NAME=VOID XMD
PREFIX=.
MODE=public
OWNER_NUMBER=2348012345678
PAIRING_NUMBER=2348012345678
PORT=3000
DATA_DIR=/data
TIMEZONE=Africa/Lagos
WEB_ADMIN_KEY=replace-with-a-long-random-password
# Optional OpenAI-compatible AI provider
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional: improves .websearch results. The command has a keyless fallback.
BRAVE_SEARCH_API_KEY=

# Total sessions including the primary account. Keep this low on small hosts.
MAX_WHATSAPP_SESSIONS=3
