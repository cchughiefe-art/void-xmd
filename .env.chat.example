BOT_NAME=VOID XMD V2
PREFIX=.
MODE=public
OWNER_NUMBER=2348012345678
PAIRING_NUMBER=2348012345678
PORT=3000
DATA_DIR=./data
TIMEZONE=Africa/Lagos
WEB_ADMIN_KEY=replace-with-a-long-random-password
MAX_WHATSAPP_SESSIONS=4
# Preferred providers. Only providers with a key are tried.
AI_PROVIDER_ORDER=gemini,groq,openrouter,cloudflare,huggingface,mistral,nvidia,cohere,cerebras
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
HF_TOKEN=
# Pick a current text-chat model from the Hugging Face provider catalog.
HUGGINGFACE_MODEL=
# Optional trial / experimental providers. Leave disabled for normal operation.
AI_EXPERIMENTAL_PROVIDERS=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
# Existing custom endpoint only used if explicitly enabled in this profile.
AI_ALLOW_CUSTOM=false
